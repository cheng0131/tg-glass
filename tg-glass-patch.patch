+  // --- rim light ------------------------------------------------------------
+  // n_cos is 1 at the rim (grazing) and 0 a full thickness inside, so Fresnel
+  // has to grow with n_cos.
+  half rimMask = 1.0 - smoothstep(0.0, thick * 0.9, -sd);
+  half fres = pow(n_cos, 3.0);
+
+  half nlen = max(length(normal_xy), 0.0001);
+  half2 n2 = normal_xy / nlen;
+
+  half2 keyLight = normalize(half2(-0.42, -0.92));
+  half spec1 = pow(max(dot(n2, keyLight), 0.0), 6.5);
+
+  half2 fillLight = normalize(half2(0.55, 0.83));
+  half spec2 = pow(max(dot(n2, fillLight), 0.0), 16.0);
+
+  half3 rim = half3(1.0, 0.995, 0.98) * (spec1 * 0.92 + fres * 0.72) * rimMask;
+  rim += half3(0.80, 0.90, 1.0) * spec2 * 0.46 * rimMask;
+
+  half3 col = refr + rim;
+
